# Ключ OpenRouter: https://openrouter.ai/settings/keys — живёт только на сервере
OPENROUTER_API_KEY=
# Бесплатные модели через запятую: первая — основная, остальные — запасные
# (OpenRouter сам переключится, если первая отдала 429 или лежит)
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nex-agi/nex-n2.5-mini:free,google/gemma-4-31b-it:free
PORT=8787
